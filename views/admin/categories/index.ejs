<div id="admin-content">
  <div class="container">
    <div class="row">
      <div class="col-md-10">
        <h1 class="admin-heading">
          <i class="fa fa-gears"></i> All Categories
        </h1>
      </div>
      <div class="col-md-2">
        <a class="add-new" href="/admin/add-category">add category</a>
      </div>
      <div class="col-md-12">
        <!-- <%= categories %> -->
        <div id="categories"></div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script
  type="text/javascript"
  src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"
></script>

<script>
     const tableData = <%- JSON.stringify(categories) %>
     console.log(tableData)
  async function deleteCategory(id){
      try{
        if(confirm("Are you sure you want to delete this category?")){
          const response = await fetch(`/admin/delete-category/${id}`,{
            method:"DELETE",});
            if(response.ok){
              window.location.reload();
            }
            if(response.status == 400){
              const data = await response.json()
              alert(data.message)
            }
        }
      }catch(e){
        console.log(e);
    }
  }
     var table = new Tabulator("#categories", {
      data:tableData,           //load row data from array
      layout:"fitColumns",      //fit columns to width of table
      responsiveLayout:"hide",  //hide columns that don't fit on the table
      addRowPos:"top",          //when adding a new row, add it to the top of the table
      history:true,             //allow undo and redo actions on the table
      pagination:"local",       //paginate the data
      paginationSize:10,         //allow 7 rows per page of data
      paginationSizeSelector:[1,10,15,50],  // custom pagination options
      paginationCounter:"rows", //display count of paginated rows in footer
      movableColumns:true,      //allow column order to be changed
      initialSort:[             //set the initial sort order of the data
          {column:"name", dir:"asc"},
      ],
      columnDefaults:{
          tooltip:true,         //show tool tips on cells
      },
      columns:[                 //define the table columns
          {title:'Sr.No.',formatter:'rownum',width:100,hozontalAlign:'center'},
          {title:"Category Name", field:"name", headerFilter:"input"},
          {title:"Slug", field:"slug", headerFilter:"input"},
          {title:"Actions", formatter:function(cell,formatterParams,onRendered){
            return `<a href="/admin/update-category/${cell.getData()._id}" class="btn btn-sm btn-success">Edit</a>
            <button class="btn btn-sm btn-danger delete-user" onclick="deleteCategory('${cell.getData()._id}')">Delete</button>`;
          }}

      ],
  });
</script>

<%- contentFor('tabulatorCss') %>
<link
  href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css"
  rel="stylesheet"
/>
<link href="/css/tabulator_bootstrap5.min.css" rel="stylesheet" />
