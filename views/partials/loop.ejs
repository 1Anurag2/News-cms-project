<% news.forEach(function(item) { %>
<div class="post-container">
  <div class="post-content">
    <div class="row">
      <div class="col-md-4" style="overflow: hidden; border-radius: 5px">
        <a class="post-img" href="/single/<%= item._id %>">
          <img
            src="/uploads/<%= item.image %>"
            alt=""
            style="
              width: 100%;
              height: 100%;
              object-fit: cover;
              border-radius: 5px;
            "
          />
        </a>
      </div>

      <div class="col-md-8">
        <div class="inner-content clearfix">
          <h3><a href="/single/<%= item._id %>"><%= item.title %></a></h3>
          <div class="post-information">
            <span>
              <i class="fa fa-tags" aria-hidden="true"></i>
              <a href="/category/<%= item.category.slug %>"
                ><%= item.category.name %></a
              >
            </span>
            <span>
              <i class="fa fa-user" aria-hidden="true"></i>
              <a href="/author/<%= item.author._id %>"
                ><%= item.author.fullname %></a
              >
            </span>
            <span>
              <i class="fa fa-calendar" aria-hidden="true"></i>
              <% var date = new Date(item.createdAt); %> <%=
              date.toLocaleString('en-US', { year: 'numeric', month: 'long',
              day: 'numeric' }) %>
            </span>
          </div>
          <div style="max-height: 80px; overflow-y: auto">
            <p class="description"><%= item.summary %></p>
          </div>
          <a class="read-more pull-right" href="/single/<%= item._id %>"
            >read more</a
          >
        </div>
      </div>
    </div>
  </div>
</div>
<% }); %>


<% if (totalPages > 1) { %>
<nav>
  <ul class="pagination">
    <% if (hasPrevPage) { %>
      <li class="page-item">
        <a class="page-link" href="<%= baseUrl %>?page=<%= prevPage %>">Previous</a>
      </li>
    <% } else { %>
      <li class="page-item disabled">
        <span class="page-link">Previous</span>
      </li>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= i === currentPage ? 'active' : '' %>">
        <a class="page-link" href="<%= baseUrl %>?page=<%= i %>" <%= i === currentPage ? 'aria-current="page"' : '' %>>
          <%= i %>
        </a>
      </li>
    <% } %>

    <% if (hasNextPage) { %>
      <li class="page-item">
        <a class="page-link" href="<%= baseUrl %>?page=<%= nextPage %>">Next</a>
      </li>
    <% } else { %>
      <li class="page-item disabled">
        <span class="page-link">Next</span>
      </li>
    <% } %>
  </ul>
</nav>
<% } %>
